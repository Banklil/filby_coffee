# ===== Railway Production =====
# DATABASE_URL  → copy from Railway PostgreSQL plugin (Variables tab)
# SECRET_KEY    → generate: python -c "import secrets; print(secrets.token_hex(32))"

DATABASE_URL=postgresql://filby:filby123@localhost:5432/filby_admin
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — add your Railway frontend URL here after deploying frontend
CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]
FRONTEND_URL=https://your-frontend-name.railway.app

UPLOAD_DIR=./uploads
ENVIRONMENT=production

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@filby.la
